# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NSE Downloader Configuration
NSE_OUTPUT_DIR="./data"
NSE_LOG_DIR="./logs"
NSE_LOG_LEVEL="INFO"
NSE_REQUEST_TIMEOUT=15
NSE_MAX_RETRIES=3
NSE_INITIAL_BACKOFF=1.5
NSE_BACKOFF_MULTIPLIER=2.0
